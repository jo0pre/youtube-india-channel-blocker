{
  "manifest_version": 3,
  "name": "YouTube India Channel Blocker",
  "version": "1.3",
  "description": "Automatically detects and hides YouTube channels based in India from your feed.",
  "homepage_url": "https://jo0pre.github.io/portfolio/",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
